{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/puzzle-info",
      "destination": "/api/puzzle-info.js"
    },
    {
      "source": "/api/puzzle-info/",
      "destination": "/api/puzzle-info.js"
    },
    {
      "source": "/api/check-guess",
      "destination": "/api/check-guess.js"
    },
    {
      "source": "/api/check-guess/",
      "destination": "/api/check-guess.js"
    }
  ],
  "redirects": [
    {
      "source": "/api/_data/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file*.csv",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file*.md",
      "destination": "/",
      "permanent": false
    }
  ]
}

